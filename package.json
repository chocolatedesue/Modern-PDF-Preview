{
  "name": "modern-pdf-preview",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "chocolatedesue",
  "icon": "icon.png",
  "author": {
    "name": "chocolatedesue"
  },
  "homepage": "https://github.com/chocolatedesue/vscode-pdf",
  "license": "MIT",
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "repository": {
    "url": "https://github.com/chocolatedesue/vscode-pdf"
  },
  "version": "1.5.10",
  "browser": "./dist/extension.browser.js",
  "main": "./dist/extension.node.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "modernPdfViewer.PDFEdit",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "modernPdfViewer.defaultZoomLevel": {
          "type": "string",
          "default": "page-width",
          "enum": [
            "page-width",
            "page-fit",
            "page-height",
            "auto",
            "50%",
            "75%",
            "100%",
            "125%",
            "150%",
            "200%",
            "300%",
            "400%"
          ],
          "description": "%configuration.defaultZoomLevel.description%"
        },
        "modernPdfViewer.defaultSpreadMode": {
          "type": "string",
          "default": "odd",
          "enum": [
            "none",
            "odd",
            "even"
          ],
          "description": "%configuration.defaultSpreadMode.description%"
        },
        "modernPdfViewer.tabBar": {
          "type": "string",
          "default": "never",
          "enum": [
            "always",
            "multiple",
            "never"
          ],
          "description": "%configuration.tabBar.description%"
        },
        "modernPdfViewer.worker": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.worker.description%"
        }
      }
    },
    "commands": [
      {
        "command": "modernPdfViewer.forceSave",
        "title": "%command.forceSave.title%",
        "category": "%command.category%"
      }
    ],
    "keybindings": [
      {
        "command": "modernPdfViewer.forceSave",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'modernPdfViewer.PDFEdit'"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeCustomEditorId == 'modernPdfViewer.PDFEdit'"
      }
    ]
  },
  "activationEvents": [
    "onCustomEditor:modernPdfViewer.PDFEdit",
    "onCommand:modernPdfViewer.forceSave"
  ],
  "scripts": {
    "build": "webpack",
    "package": "sh scripts/package.sh",
    "deploy": "sh scripts/publish.sh",
    "test-web": "vscode-test-web --extensionDevelopmentPath=. .",
    "test-web-headless": "vscode-test-web --extensionDevelopmentPath=. --headless ."
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@embedpdf/svelte-pdf-viewer": "^2.14.4",
    "@types/vscode": "1.75.0",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "^3.9.2",
    "css-loader": "^7.1.4",
    "ovsx": "^1.0.1",
    "style-loader": "^4.0.0",
    "svelte": "^5.56.3",
    "svelte-loader": "^3.2.4",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "dependencies": {
    "@embedpdf/core": "^2.14.4",
    "@embedpdf/plugin-document-manager": "^2.14.4",
    "@embedpdf/plugin-render": "^2.14.4"
  }
}
